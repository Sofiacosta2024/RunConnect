# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of your app (required for Google OAuth redirect_uri)
BETTER_AUTH_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/runconnect

# Google OAuth
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron job secret (used to authenticate cron endpoint calls)
# Generate with: openssl rand -base64 32
CRON_SECRET=
# SMTP Parameters for Email purposes

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=